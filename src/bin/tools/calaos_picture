#!/bin/bash

# Usage: calaos_picture <url> <filename> [-w|--width width] [-r|--rotate degrees]
#
# Exit codes:
#   0  filename holds the image, resized and rotated as asked
#   1  nothing was written: bad usage, or the download failed
#   3  filename holds the image as downloaded: ImageMagick is missing or failed

showUsage()
{
    echo "Usage: calaos_picture <url> <filename> -w|--width [width] -r|--rotate [rotate]"
    exit 1
}

# Parse command line arguments
OPTIONS=$(getopt -o r:w: --long rotate:,width: -- "$@") || showUsage
eval set -- "$OPTIONS"

# Set default values
rotate=""
width=""

# Process options
while true; do
  case "$1" in
    -r|--rotate)
      rotate="$2"
      shift 2;;
    -w|--width)
      width="$2"
      shift 2;;
    --)
      shift; break;;
    *)
      echo "Invalid option: $1" >&2; exit 1;;
  esac
done

# Get remaining arguments
url="$1"
filename="$2"

if [ "$url" == "" ]; then
    showUsage
fi
if [ "$filename" == "" ]; then
    showUsage
fi

if ! command -v curl > /dev/null 2>&1 ; then
    echo "curl is not installed."
    exit 1
fi

work="${filename}_curl"
converted="${filename}_conv"
childPid=""

# The server sends SIGTERM when its client leaves and counts this script as
# running until it exits. A foreground command defers the trap until it ends,
# so curl and convert run in the background and cleanup stops and reaps them.
cleanup()
{
    if [ -n "$childPid" ]; then
        kill "$childPid" 2> /dev/null
        wait "$childPid" 2> /dev/null
    fi
    rm -f "$work" "$converted"
}
trap cleanup EXIT
trap 'exit 1' TERM

curl -s --fail --max-time 30 --output "$work" --url "$url" &
childPid=$!
wait "$childPid" || exit 1
childPid=""

if [ "$width" == "" ] && [ "$rotate" == "" ]; then
    mv "$work" "$filename"
    exit 0
fi

keepOriginal()
{
    echo "$1 Image is not resized."
    mv "$work" "$filename"
    exit 3
}

if ! command -v convert > /dev/null 2>&1 || ! command -v timeout > /dev/null 2>&1 ; then
    keepOriginal "imagemagick or timeout is not installed."
fi

# convert goes to a file of its own: a convert stopped half way must not leave
# a truncated frame in place of the original.
transform()
{
    timeout -k 2 30 convert "$work" "$@" "$converted" &
    childPid=$!
    wait "$childPid"
    local status=$?
    childPid=""
    [ "$status" -eq 0 ] && mv "$converted" "$work"
}

# Resize image and rotate before resizing
if [ ! "$rotate" == "" ]; then
    transform -rotate "$rotate" || keepOriginal "convert failed."
fi

if [ ! "$width" == "" ]; then
    transform -thumbnail "$width" || keepOriginal "convert failed."
fi

mv "$work" "$filename"
