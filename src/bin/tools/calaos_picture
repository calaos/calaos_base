#!/bin/bash

# Usage: calaos_picture <url> <filename> [-w|--width width] [-r|--rotate degrees]
#
# Exit codes:
#   0  filename holds the image, resized and rotated as asked
#   1  nothing was written: bad usage, or the download failed
#   3  filename holds the image as downloaded: ImageMagick is missing or failed

showUsage()
{
    echo "Usage: calaos_picture <url> <filename> -w|--width [width] -r|--rotate [rotate]"
    exit 1
}

# Parse command line arguments
OPTIONS=$(getopt -o r:w: --long rotate:,width: -- "$@") || showUsage
eval set -- "$OPTIONS"

# Set default values
rotate=""
width=""

# Process options
while true; do
  case "$1" in
    -r|--rotate)
      rotate="$2"
      shift 2;;
    -w|--width)
      width="$2"
      shift 2;;
    --)
      shift; break;;
    *)
      echo "Invalid option: $1" >&2; exit 1;;
  esac
done

# Get remaining arguments
url="$1"
filename="$2"

if [ "$url" == "" ]; then
    showUsage
fi
if [ "$filename" == "" ]; then
    showUsage
fi

if ! command -v curl > /dev/null 2>&1 ; then
    echo "curl is not installed."
    exit 1
fi

work="${filename}_curl"
curlPid=""

cleanup()
{
    if [ -n "$curlPid" ]; then
        kill "$curlPid" 2> /dev/null
    fi
    rm -f "$work"
}
trap cleanup EXIT

# The server sends SIGTERM when its client leaves. In the foreground curl would
# hold this script, and a process slot's worth of work, until the camera answers.
trap 'exit 1' TERM

curl -s --fail --max-time 30 --output "$work" --url "$url" &
curlPid=$!
wait "$curlPid" || exit 1
curlPid=""

if [ "$width" == "" ] && [ "$rotate" == "" ]; then
    mv "$work" "$filename"
    exit 0
fi

keepOriginal()
{
    echo "$1 Image is not resized."
    mv "$work" "$filename"
    exit 3
}

if ! command -v convert > /dev/null 2>&1 ; then
    keepOriginal "imagemagick is not installed."
fi

# Resize image and rotate before resizing
if [ ! "$rotate" == "" ]; then
    convert "$work" -rotate "$rotate" "$work" || keepOriginal "convert failed."
fi

if [ ! "$width" == "" ]; then
    convert "$work" -thumbnail "$width" "$work" || keepOriginal "convert failed."
fi

mv "$work" "$filename"
